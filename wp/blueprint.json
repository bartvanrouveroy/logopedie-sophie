{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Logopedie Sophie – WordPress-demo",
		"description": "Volledige voorbeeldsite: thema, WooCommerce-webshop, oefenportaal met rollen, chat en contactformulier.",
		"author": "bartvanrouveroy"
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" },
			"options": { "activate": true }
		},
		{ "step": "setSiteLanguage", "language": "nl_BE" },
		{
			"step": "installTheme",
			"themeData": { "resource": "url", "url": "https://bartvanrouveroy.github.io/logopedie-sophie/wp/logopedie-sophie.zip" },
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "url", "url": "https://bartvanrouveroy.github.io/logopedie-sophie/wp/sophie-oefenportaal.zip" },
			"options": { "activate": true }
		},
		{
			"step": "unzip",
			"zipFile": { "resource": "url", "url": "https://bartvanrouveroy.github.io/logopedie-sophie/wp/ls-setup.zip" },
			"extractToPath": "/wordpress/ls-setup"
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; wp_set_current_user( 1 ); require '/wordpress/ls-setup/setup/setup.php';"
		}
	]
}
